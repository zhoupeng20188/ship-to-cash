---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout title="Contact | ShipToCash">
  <div class="max-w-3xl mx-auto px-4 pt-10">
    <h1 class="text-3xl font-bold text-ink-900 mb-8">Contact</h1>
    <div class="prose">
      <p>
        Questions, corrections, or a topic you'd like us to cover?
        The fastest way to reach me is on
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-600 hover:text-brand-700 underline">GitHub</a>.
      </p>
      <p>
        For a correction, include the article URL, the step or code block, your framework
        and hosting environment, the error message, and a link to the current official
        documentation if available. Remove API keys, payment details, and customer
        information before sharing logs.
      </p>
      <h2>Corrections and privacy requests</h2>
      <p>
        This site is maintained by Peng Zhou. Use the contact options on the linked
        GitHub profile for content corrections or privacy questions. Public GitHub
        messages are visible to others; do not post private account details there.
      </p>
    </div>
  </div>
</BaseLayout>
