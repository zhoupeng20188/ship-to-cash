---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS, toolHref } from '../../data/tools';

const TITLE = 'Free Tools for Selling Digital Products';
const DESCRIPTION =
  'Free, no-signup calculators for people selling digital products: work out the list price that leaves you the net you actually want.';

const tools = TOOLS;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shiptocash.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://shiptocash.com/tools/' },
  ],
};

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: TITLE,
  url: 'https://shiptocash.com/tools/',
  description: DESCRIPTION,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: `https://shiptocash.com${toolHref(t)}`,
    })),
  },
};
---

<BaseLayout title={`${TITLE} | ShipToCash`} description={DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(listLd)} />

  <div class="max-w-4xl mx-auto px-4 pt-10">
    <nav class="flex items-center gap-2 text-sm text-ink-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>/</span>
      <span class="text-ink-700">Tools</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-ink-900">{TITLE}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-600 leading-relaxed">
      Small calculators that answer one question each, the way the platforms' own dashboards will not.
      Everything runs in your browser — no account, no email, no server.
    </p>

    <div class="mt-10 space-y-5">
      {tools.map((t) => (
        <a
          href={toolHref(t)}
          class="block rounded-xl border border-ink-200 bg-white p-6 hover:shadow-lg hover:border-brand-300 transition-all duration-200 dark:bg-ink-100"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{t.tagline}</p>
              <h2 class="mt-1 text-xl font-bold text-ink-900">{t.name}</h2>
            </div>
            <span class="text-brand-600 text-xl leading-none mt-1" aria-hidden="true">&rarr;</span>
          </div>
          <p class="mt-3 text-ink-600 leading-relaxed">{t.body}</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-500">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
        </a>
      ))}
    </div>

    <div class="mt-14 rounded-xl border border-ink-200 bg-ink-50 p-5 dark:bg-ink-50">
      <h2 class="font-bold text-ink-900">Why these exist</h2>
      <p class="mt-2 text-sm text-ink-600 leading-relaxed">
        Every rate in these tools is read from the provider's own pricing page and dated, because fees change
        without announcement. If a number here is stale, the fields are editable — the arithmetic is the part
        that stays useful.
      </p>
    </div>

    <div class="h-16"></div>
  </div>
</BaseLayout>
