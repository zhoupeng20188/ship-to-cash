---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import { SITE, getCategoryBySlug } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { category: post.data.category, slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sameCategory = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const relatedPosts = [...sameCategory];
if (relatedPosts.length < 3) {
  const fillers = allPosts
    .filter((p) => p.id !== post.id && p.data.category !== post.data.category)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3 - relatedPosts.length);
  relatedPosts.push(...fillers);
}

const faq = post.data.faq ?? [];

/* ---- Structured data (BlogPosting + BreadcrumbList) ---- */
const site = Astro.site ?? new URL('https://shiptocash.com');
const cat = getCategoryBySlug(post.data.category);
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const categoryName = cat?.name ?? post.data.category;
const categoryUrl = new URL(`/${post.data.category}/`, site).toString();
const authorUrl = new URL('/about/', site).toString();
const articleImage = new URL(post.data.image ?? `/og-${post.id}.jpg`, site).toString();
const authorImage = new URL(SITE.avatar, site).toString();
const publisherLogo = new URL('/og-default.jpg', site).toString();
const dateModified = (post.data.updatedDate ?? post.data.pubDate).toISOString();
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  difficulty={post.data.difficulty}
  category={post.data.category}
  wordCount={wordCount}
  readingMinutes={readingMinutes}
  headings={headings}
  image={post.data.image ?? `/og-${post.id}.jpg`}
>
  <Content />

  <Fragment slot="after">
    {faq.length > 0 && (
      <section class="mt-12 pt-8 border-t border-ink-200">
        <h2 class="text-2xl font-bold text-ink-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          {faq.map((item) => (
            <div>
              <h3 class="text-lg font-semibold text-ink-900 mb-2">{item.question}</h3>
              <p class="text-ink-600 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <AuthorBio />

    <RelatedPosts posts={relatedPosts} currentId={post.id} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'BlogPosting',
            '@id': `${canonicalUrl}#article`,
            headline: post.data.title,
            description: post.data.description,
            image: [articleImage],
            datePublished: post.data.pubDate.toISOString(),
            dateModified,
            inLanguage: 'en',
            wordCount,
            articleSection: categoryName,
            author: {
              '@type': 'Person',
              name: post.data.author,
              url: authorUrl,
              image: authorImage,
              jobTitle: 'Vibe coder & Founder of ShipToCash',
              sameAs: [SITE.github, 'https://aikitguides.com'],
            },
            publisher: {
              '@type': 'Organization',
              name: SITE.name,
              url: site.toString(),
              logo: { '@type': 'ImageObject', url: publisherLogo },
            },
            mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
            isPartOf: { '@type': 'Blog', '@id': `${site.toString()}#blog`, name: SITE.name },
          },
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonicalUrl}#breadcrumb`,
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
              { '@type': 'ListItem', position: 2, name: categoryName, item: categoryUrl },
              { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
            ],
          },
        ],
      })}
    />

    {faq.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        })}
      />
    )}
  </Fragment>
</PostLayout>
