---
interface Props {
  level: 'beginner' | 'intermediate';
}
const { level } = Astro.props;
const styles = {
  beginner: 'bg-green-50 text-green-700 dark:bg-green-900/40 dark:text-green-300',
  intermediate: 'bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
};
const labels = { beginner: 'Beginner', intermediate: 'Intermediate' };
---

<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${styles[level]}`}>
  {labels[level]}
</span>
